# Production ortam degiskenleri. Bu dosyayi sunucuda ".env.prod" adiyla kopyala
# ve degerleri doldur. .env.prod ASLA commit edilmez (.gitignore'da).

# --- Site adresi (Caddy) ---
# VM'nin statik IP'si A.B.C.D ise: A-B-C-D.sslip.io  |  Lokal test icin: :80
SITE_ADDRESS=A-B-C-D.sslip.io

# --- Veritabani ---
# Guclu bir sifre uret ve AYNI sifreyi DATABASE_URL icine de yaz
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql+asyncpg://kurgu_admin:strong_password_here@postgres:5432/kurgu_db

# --- Guvenlik ---
# Uret: openssl rand -hex 32
JWT_SECRET=change_me_openssl_rand_hex_32
JWT_EXPIRES_MINUTES=1440

# --- Embedding (SUNUCU anahtari OpenAI; kullanicilarin uretim anahtarlari BYOK ile tarayicidan gelir) ---
# Olay-retrieval OpenAI text-embedding-3-small (dimensions=768) uzayinda. Bu anahtarda
# BILLING ACIK olmali (free tier prod'da 429 verir). Kullanici anahtari burada ASLA kullanilmaz.
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768
EMBED_DAILY_LIMIT=300

# --- Uygulama ---
ENV=production
CORS_ORIGINS=https://A-B-C-D.sslip.io
LLM_CONCURRENCY=4

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# "Authorized JavaScript origins" alanina site adresini ekle (https://A-B-C-D.sslip.io).
# Bos birakilirsa Google girisi kapali kalir, buton gizlenir.
GOOGLE_OAUTH_CLIENT_ID=
