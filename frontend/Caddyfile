# SITE_ADDRESS ornekleri:
#   Prod : A-B-C-D.sslip.io   (VM'nin IP'si A.B.C.D ise; Caddy sertifikayi otomatik alir)
#   Lokal: :80                (sertifikasiz duz HTTP)
{$SITE_ADDRESS} {
	handle /api/* {
		# FastAPI/Pydantic sinirlarina ulasmadan ONCE kesilsin diye burada: aksi halde
		# buyuk bir govde uygulama katmanina kadar tasinir (bellek/CPU o noktaya kadar
		# zaten harcanmis olur). En buyuk mesru govde bir bolum duzenlemesi (~60.000
		# karakter + JSON/camelCase payı); MAX_REQUEST_BODY_SIZE .env.prod'dan gelir,
		# yoksa 1MB varsayilir.
		request_body {
			max_size {$MAX_REQUEST_BODY_SIZE:1MB}
		}
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}

	# Ek katman, ana savunma DEGIL: stream-token uc-kullanimlik + ~60sn omurlu (bkz.
	# security.py create_stream_token). Yine de erisim logunda DUZ METIN durmasin diye
	# query string'deki token degeri burada maskelenir.
	#
	# KAPSAM SINIRI (bilincli kabul edildi, KAPATILMADI): bu filtre YALNIZCA
	# http.log.access'i kapsar. Backend'e ulasilamadiginda (dial hatasi vb.) Caddy ayri
	# bir logger'a (http.log.error) yazar ve o satirda token MASKELENMEZ. Kapatmak icin
	# handle_errors bloguyla o logger'i da ayni filtreden gecirmek gerekir ama bu
	# Caddyfile'i karmasiklastirir ve yanlis yazilirsa SSE'yi bozma riski tasir — risk
	# kazanctan buyuk: token zaten 60sn + tek kullanimlik, sizmasi icin backend'in TAM
	# o anda erisilemez olmasi gerekir ki o durumda zaten kullanilamaz haldedir.
	log {
		format filter {
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}
