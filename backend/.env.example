# --- Veritabani ---
DATABASE_URL=postgresql+asyncpg://kurgu_admin:admin_password_123@localhost:5432/kurgu_db

# --- Guvenlik ---
# Uretimde mutlaka degistir: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=1440

# --- LLM (OpenAI SDK uzerinden Gemini) ---
# Saglayici degistirmek istersen sadece bu uc satiri degistirmen yeterli.
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Hikaye yazimi icin guclu model (or. gemini-3.1-pro), ozet/yardimci isler icin ucuz model
LLM_STORY_MODEL=gemini-3.5-flash
LLM_UTIL_MODEL=gemini-3.5-flash

# --- Embedding ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Ayni anda en fazla kac LLM cagrisi yapilsin (ucretsiz kota icin dusuk tut)
LLM_CONCURRENCY=2

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
