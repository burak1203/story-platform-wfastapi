# --- Veritabani ---
DATABASE_URL=postgresql+asyncpg://kurgu_admin:admin_password_123@localhost:5432/kurgu_db

# --- Guvenlik ---
# Uretimde mutlaka degistir: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=1440

# --- LLM (BYOK) ---
# Uretim tarafinda SUNUCUDA HICBIR varsayilan/anahtar YOK. Her kullanici ayar ekranindan
# saglayici + base URL + model + anahtar girer; bunlar X-LLM-Provider / X-LLM-Base-URL /
# X-LLM-Model / X-LLM-API-Key header'lariyla gelir. Sunucuya .env'ye LLM_* yazilmaz.

# --- Embedding (SUNUCU anahtari OpenAI; kullanicinin BYOK anahtarindan tamamen bagimsiz) ---
# Olay-retrieval OpenAI uzayindadir. Kullanici anahtari embedding'de, sunucu anahtari
# uretimde ASLA kullanilmaz. text-embedding-3-small API'de dimensions=768 uygular.
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=openai
# openai icin bos birak (api.openai.com). Alternatif "gemini" icin openai-uyumlu ucu yaz:
# https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768
# Kullanici basina gunluk embed cagri kotasi (asiminda 429)
EMBED_DAILY_LIMIT=300

# Ayni anda en fazla kac LLM cagrisi yapilsin (ucretsiz kota icin dusuk tut)
LLM_CONCURRENCY=2

# --- Google OAuth (bos ise Google girisi kapali, buton gizlenir) ---
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
